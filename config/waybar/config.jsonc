{
    "layer": "top", 
    "position": "top", 
    "height": 28, 
    "spacing": 6, 

    "modules-left": [
        "custom/hyprLauncher",
        "hyprland/workspaces",
    ],

    "modules-center": [
        "clock", 
        "mpris",
    ],

    "modules-right": [
        "network",
        "power-profiles-daemon",
        "backlight",
        "pulseaudio",
        "group/hardware",
        "tray",
    ],

    "hyprland/window": {
        "max-length": 50,
    },

    "hyprland/workspaces": {
        "interval": 1,
        "disable-scroll": false,
        "all-outputs": true,
        "warp-on-scroll": false,
        "format": "<sup>{icon}</sup>{windows}",
        "window-rewrite-default": "󰊲",
        "format-window-seperator": "\n",
        "window-rewrite": {
            "Instagram": "󰋾 ",
            "blender": "󰂫 ",
            "class<Minecraft.*>": "󰍳 ",
            "class<discord> title<.*discord.*>": " ",
            "class<spotify>": " ",
            "code": " ",
            "dolphin": " ",
            "foot": " ",
            "kitty": " ",
            "neovim": "",
            "notion": " ",
            "nvim": "",
            "title<.*Browser.*>": " ",
            "title<.*Firefox.*>": "󰈹 ",
            "title<.*Neovim.*>": "",
            "title<.*Nvim.*>": "",
            "vesktop": " ",
        },
    },

    "custom/hyprLauncher": {
        "format": "󰣇 ",
        "tooltip": true,
        "tooltip-format": "Search Application",
        "on-click": "rofi -show drun -p 'Search For Application:' -config application.rasi"
    },

    "group/hardware": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": false,
        },
        "modules": [
            "battery",
            "cpu",
            "memory",
            "temperature",
        ]
    },

    "mpris": {
        "interval": 1,
        "format": "{player_icon}  {status_icon}   {title}",
        "status-icons": {
            "playing": "",
            "paused": ""
        },
        "max-length":25,
        "on-click": "playerctl play-pause",
        "on-scroll-down": "playerctl next",
        "on-scroll-up": "playerctl previous",
        "player-icons": {
            "spotify": " "
        }
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10,
    },

    "clock": {
        "format": " {:%b-%d , %H:%M} ",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "left",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#cdd6f4'><b>{}</b></span>",
                "days": "<span color='#e0f0ff'>{}</span>",
                "weekdays": "<span color='#bac2de'><b>{}</b></span>",
                "today": "<span color='#89b4fa'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "cpu": {
        "format": "{usage}%  ",
    },

    "memory": {
        "format": "{}%  " 
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },

    "backlight": {
        "format": "{icon}",
        "tooltip-format": "{percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        "format-icons": ["", "", "", "", ""]
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },

    "network": {
        "interval": 1,
        "format-wifi": "<span color='#3DED97'> {bandwidthUpBits}</span> <span color='#ff2052'> {bandwidthDownBits}</span>   ",
        "format-ethernet": "<span color='#3DED97'> {bandwidthUpBits}</span> <span color='#ff2052'> {bandwidthDownBits}</span> 󰈀 ",
        "format-disconnected": "Disconnected ⚠",
        "tooltip": false,
        "on-click": "$HOME/dots/scripts/rowifi.sh"
    },

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}",
        "format-bluetooth-muted": " {icon}",
        "format-muted": " ",
        "format-icons": {
            "default": [" ", " ", " "]
        },
        "on-click": "pavucontrol"
    },
}
